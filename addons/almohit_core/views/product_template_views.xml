<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_almohit_product_template_form" model="ir.ui.view">
        <field name="name">almohit.product.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="almohit_brand_id"/>
                <field name="almohit_min_order_qty"/>
            </field>
            <xpath expr="//notebook" position="inside">
                <page string="Gallery images" name="almohit_gallery">
                    <field name="product_template_image_ids" nolabel="1" context="{'default_name': name}">
                        <tree>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="image_1920" widget="image" options="{'size': [90, 90]}"/>
                        </tree>
                        <form>
                            <sheet>
                                <field name="image_1920" widget="image" class="oe_avatar"/>
                                <group>
                                    <field name="name"/>
                                    <field name="sequence"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
