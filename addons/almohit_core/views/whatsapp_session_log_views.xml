<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_almohit_whatsapp_session_log_tree" model="ir.ui.view">
        <field name="name">almohit.whatsapp.session.log.tree</field>
        <field name="model">almohit.whatsapp.session.log</field>
        <field name="arch" type="xml">
            <tree create="false" delete="false" edit="false">
                <field name="create_date"/>
                <field name="event_type"/>
                <field name="status"/>
                <field name="connected"/>
                <field name="phone"/>
                <field name="message"/>
            </tree>
        </field>
    </record>

    <record id="view_almohit_whatsapp_session_log_form" model="ir.ui.view">
        <field name="name">almohit.whatsapp.session.log.form</field>
        <field name="model">almohit.whatsapp.session.log</field>
        <field name="arch" type="xml">
            <form create="false" delete="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="event_type"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="connected"/>
                            <field name="phone"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_almohit_whatsapp_session_log" model="ir.actions.act_window">
        <field name="name">Session Logs</field>
        <field name="res_model">almohit.whatsapp.session.log</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem
        id="menu_almohit_whatsapp_session_logs"
        name="Session Logs"
        parent="menu_almohit_whatsapp"
        action="action_almohit_whatsapp_session_log"
        sequence="15"
        groups="base.group_user"/>
</odoo>
