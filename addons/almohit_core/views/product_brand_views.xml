<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_almohit_product_brand_tree" model="ir.ui.view">
        <field name="name">almohit.product.brand.tree</field>
        <field name="model">almohit.product.brand</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_almohit_product_brand_form" model="ir.ui.view">
        <field name="name">almohit.product.brand.form</field>
        <field name="model">almohit.product.brand</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Brand name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_almohit_product_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">almohit.product.brand</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_almohit_product_brand"
        name="Brands"
        parent="contacts.menu_contacts"
        action="action_almohit_product_brand"
        sequence="25"
        groups="base.group_user"/>
</odoo>
