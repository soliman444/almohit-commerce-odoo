<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="almohit_core.WhatsAppAccount">
        <div class="o_almohit_whatsapp_account h-100 overflow-auto">
            <div class="o_almohit_whatsapp_card">
                <h1>WhatsApp Account</h1>
                <p class="text-muted">
                    This screen follows the live WhatsApp session. The QR appears only when there is no connection.
                </p>

                <div t-if="state.connected" class="alert alert-success mb-3" role="status">
                    <strong>Connected</strong>
                    <span t-if="state.phone"> — <t t-esc="state.phone"/></span>
                </div>
                <div t-elif="state.loading" class="alert alert-info mb-3" role="status">
                    Checking WhatsApp connection...
                </div>
                <div t-else="" class="alert alert-warning mb-3" role="status">
                    <strong>Not connected</strong>
                    <span t-if="state.status_text"> — <t t-esc="state.status_text"/></span>
                </div>

                <div t-if="state.connected and state.phone" class="mb-3">
                    <div class="text-muted">Account number</div>
                    <div class="fs-5" t-esc="state.phone"/>
                </div>
                <div t-elif="state.account_phone" class="mb-3 text-muted">
                    Last saved number: <t t-esc="state.account_phone"/>
                </div>

                <div t-if="!state.connected" class="o_almohit_whatsapp_qr mb-4">
                    <t t-if="state.qr">
                        <p>On the new phone open WhatsApp → Linked devices → Link a device, then scan this code.</p>
                        <img t-att-src="qrSrc" alt="WhatsApp QR" width="260" height="260"/>
                        <p class="text-muted mt-2 mb-0">This screen updates automatically after a successful scan.</p>
                    </t>
                    <t t-else="">
                        <p class="mb-0">Preparing a new QR code...</p>
                    </t>
                </div>

                <button
                    type="button"
                    class="btn btn-primary"
                    t-on-click="confirmChangeAccount"
                    t-att-disabled="state.busy">
                    Change account
                </button>
            </div>
        </div>
    </t>
</templates>
