    <record id="seq_almohit_inventory_session" model="ir.sequence">
        <field name="name">Almohit Inventory Session</field>
        <field name="code">almohit.inventory.session</field>
        <field name="prefix">WH/INV/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
