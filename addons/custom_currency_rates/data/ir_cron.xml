<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_custom_currency_rates" model="ir.cron">
        <field name="name">Custom currency rates: daily sync</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="False"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_rates()</field>
        <field name="model_id" ref="model_custom_currency_rate_sync"/>
        <field
            name="nextcall"
            eval="(DateTime.now() + timedelta(minutes=5)).strftime('%Y-%m-%d %H:%M:%S')"
        />
    </record>
</odoo>
