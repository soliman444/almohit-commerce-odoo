<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_travel_frankfurter_currency_rates" model="ir.cron">
        <field name="name">Travel: update currency buy/sell rates (Frankfurter)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="False"/>
        <field name="state">code</field>
        <field name="code">model.cron_travel_fetch_frankfurter_rates()</field>
        <field name="model_id" ref="base.model_res_currency"/>
        <field
            name="nextcall"
            eval="(DateTime.now() + timedelta(hours=2)).strftime('%Y-%m-%d %H:%M:%S')"
        />
    </record>
</odoo>
